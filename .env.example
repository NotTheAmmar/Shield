# ── Blockchain (Private EVM Network) ──────────────────────────────────────────
# These variables are used by shield-ledger for future EVM contract integration.
# Start the blockchain stack first: npm run blockchain:up
# Then compile contracts: npx hardhat compile
#
# node-police RPC (institutional signer for police station transactions)
BLOCKCHAIN_RPC_URL=http://node-police:8545

# node-court RPC (institutional signer for court/judicial transactions)
BLOCKCHAIN_COURT_RPC_URL=http://node-court:8545

# Chain configuration
BLOCKCHAIN_CHAIN_ID=31337

# Pre-generated institutional Ethereum addresses (see blockchain/keystore/)
BLOCKCHAIN_POLICE_ADDRESS=0x80de6eF5a945D6Cc1DAd5375E3CeD4DF466e0384
BLOCKCHAIN_COURT_ADDRESS=0x01a08fc1e3c0EB8d2Be2301Ba36761485d1a2B4e
BLOCKCHAIN_FIR_CONTRACT_ADDRESS=0x5b1837f959dFA6F3Fb2Ee1F9AFBffB71c539110e
BLOCKCHAIN_EVIDENCE_CONTRACT_ADDRESS=0xd90974F953102CCe9bE0531CbB924F605e18Ec01

# Private key for the node-police deployer account (used by Hardhat to sign contract deployments)
# Extract from blockchain/keystore/police-account.json using the password in blockchain/password.txt:
#   node -e "const {ethers}=require('ethers'),fs=require('fs'); \
#     ethers.Wallet.fromEncryptedJson(fs.readFileSync('./blockchain/keystore/police-account.json','utf8'), \
#     fs.readFileSync('./blockchain/password.txt','utf8').trim()).then(w=>console.log(w.privateKey))"
BLOCKCHAIN_DEPLOYER_PRIVATE_KEY=0x_extract_from_keystore_using_command_above
