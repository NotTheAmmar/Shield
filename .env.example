MASTER_KEY=oxUNx2zUxj/CWUmcvMfQYr9yT3vrHiSltgFBGYbL99M=

# AES-256-GCM encryption key for user blockchain private keys (32 bytes, base64)
# Generate with: openssl rand -base64 32
