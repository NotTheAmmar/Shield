# CORE INFRASTRUCTURE SECRETS (TEMPLATE)
# DO NOT PUT REAL PASSWORDS IN THIS FILE

POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=shield_db_name

MINIO_ROOT_USER=your_minio_admin_user
MINIO_ROOT_PASSWORD=your_secure_minio_password

# Default System Administrator Account (Seeded on first startup)
ADMIN_SEED_EMAIL=admin@police.gov
ADMIN_SEED_PASSWORD=Sh13ld@Pr0duct10n2026!
ADMIN_SEED_NAME="System Administrator"
ADMIN_SEED_EMPLOYEE_ID=EMP-00000

# Cryptography
JWT_SECRET=replace_this_with_a_secure_random_string
MASTER_KEY=replace_this_with_a_32_byte_base64_key

# AES-256-GCM encryption key for user blockchain private keys (32 bytes, base64)
# Generate with: openssl rand -base64 32
BLOCKCHAIN_ENCRYPTION_KEY=replace_this_with_a_32_byte_base64_key

# ── Blockchain (Private EVM Network) ──────────────────────────────────────────
# These variables are used by shield-ledger for future EVM contract integration.
# Start the blockchain stack first: npm run blockchain:up
# Then compile contracts: npx hardhat compile
#
# node-police RPC (institutional signer for police station transactions)
BLOCKCHAIN_RPC_URL=http://node-police:8545

# node-court RPC (institutional signer for court/judicial transactions)
BLOCKCHAIN_COURT_RPC_URL=http://node-court:8545

# Chain configuration
BLOCKCHAIN_CHAIN_ID=31337

# Pre-generated institutional Ethereum addresses (see blockchain/keystore/)
BLOCKCHAIN_POLICE_ADDRESS=0x80de6eF5a945D6Cc1DAd5375E3CeD4DF466e0384
BLOCKCHAIN_COURT_ADDRESS=0x01a08fc1e3c0EB8d2Be2301Ba36761485d1a2B4e
BLOCKCHAIN_CONTRACT_ADDRESS=0x110dc3e9304dd982F565aDa1343F746898941181
